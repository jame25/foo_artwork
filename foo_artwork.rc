#include "resource.h"
#include <winres.h>

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_PREFERENCES DIALOGEX 0, 0, 350, 282
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "API Services",IDC_STATIC,10,10,321,170
    
    CONTROL         "iTunes",IDC_ENABLE_ITUNES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,28,70,12
    CONTROL         "Deezer",IDC_ENABLE_DEEZER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,100,28,70,12
    CONTROL         "MusicBrainz",IDC_ENABLE_MUSICBRAINZ,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,180,28,85,12
    LTEXT           "These services require no API key.",IDC_STATIC,35,45,200,10
    
    CONTROL         "Discogs",IDC_ENABLE_DISCOGS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,65,100,12
    LTEXT           "Discogs API Key:",IDC_STATIC,35,82,85,10
    EDITTEXT        IDC_DISCOGS_KEY,125,80,190,14,ES_AUTOHSCROLL
    LTEXT           "Consumer Key:",IDC_STATIC,35,99,85,10
    EDITTEXT        IDC_DISCOGS_CONSUMER_KEY,125,97,190,14,ES_AUTOHSCROLL
    LTEXT           "Consumer Secret:",IDC_STATIC,35,116,85,10
    EDITTEXT        IDC_DISCOGS_CONSUMER_SECRET,125,114,190,14,ES_AUTOHSCROLL
    
    CONTROL         "Last.fm",IDC_ENABLE_LASTFM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,139,100,12
    LTEXT           "Last.fm API Key:",IDC_STATIC,35,156,85,10
    EDITTEXT        IDC_LASTFM_KEY,125,154,190,14,ES_AUTOHSCROLL
    
    GROUPBOX        "Priority",IDC_STATIC,10,190,321,40
    COMBOBOX        IDC_PRIORITY_1,20,205,55,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_PRIORITY_2,80,205,55,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_PRIORITY_3,140,205,55,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_PRIORITY_4,200,205,55,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_PRIORITY_5,260,205,55,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP


    LTEXT           "Disk Artwork Cache:",IDC_STATIC,20,248,70,10
    COMBOBOX        IDC_ENABLE_DISK_CACHE,92,245,69,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_BROWSE_CACHE_FOLDER,164,245,20,14
    PUSHBUTTON      "Hide Artwork Source",IDC_SHOW_SOURCE,240,245,85,16

    CONTROL         "Always skip local artwork",IDC_SKIP_LOCAL_ARTWORK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,265,150,12
    LTEXT           "Console Logging:",IDC_STATIC,180,267,60,10
    COMBOBOX        IDC_CONSOLE_LOGGING_MODE,242,264,83,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_PREFERENCES_ADVANCED DIALOGEX 0, 0, 350, 310
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Station Logos",IDC_STATIC,10,10,320,185

    CONTROL         "Enable custom station logos",IDC_ENABLE_CUSTOM_LOGOS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,25,200,12

    LTEXT           "Custom logos folder:",IDC_STATIC_LOGOS_FOLDER,20,42,100,10
    EDITTEXT        IDC_LOGOS_FOLDER_PATH,20,54,214,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BROWSE_LOGOS_FOLDER,239,54,50,14

    LTEXT           "No-Art placeholder folder (empty = use logos folder):",IDC_STATIC_NOART_FOLDER,20,72,210,10
    EDITTEXT        IDC_NOART_FOLDER_PATH,20,84,214,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BROWSE_NOART_FOLDER,239,84,50,14

    LTEXT           "No-Art Image Cycling:",IDC_STATIC_NOART_CYCLE,20,104,80,10
    COMBOBOX        IDC_NOART_CYCLE_MODE,105,102,120,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Logo files can use either full URL path or domain name:",IDC_STATIC,20,122,295,10
    LTEXT           "Full path: ice1.somafm.com_indiepop-128-aac.png / Domain: somafm.com.png",IDC_STATIC,35,134,280,10
    LTEXT           "No-Art: Place noart.png or multiple images in folder to cycle through.",IDC_STATIC,35,146,280,10
    LTEXT           "Supported formats: PNG, JPG, JPEG, WEBP, GIF, BMP",IDC_STATIC,20,162,200,10

    GROUPBOX        "Miscellaneous",IDC_STATIC,10,200,320,100

    CONTROL         "Clear panel when playback stopped",IDC_CLEAR_PANEL_WHEN_NOT_PLAYING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,214,135,12
    CONTROL         "[ Use noart image ]",IDC_USE_NOART_IMAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,214,92,12
    CONTROL         "Show Infobar (DUI only)",IDC_INFOBAR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,228,128,12
    CONTROL         "Disable in-stream artwork",IDC_DISABLE_INSTREAM_ARTWORK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,228,160,12

    LTEXT           "HTTP timeout:",IDC_STATIC_TIMEOUT,20,248,50,10
    EDITTEXT        IDC_HTTP_TIMEOUT,72,246,30,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "seconds",IDC_STATIC_SECONDS,106,248,30,10

    LTEXT           "Retry count:",IDC_STATIC_RETRY,155,248,45,10
    EDITTEXT        IDC_RETRY_COUNT,202,246,30,14,ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "(0 = no retries, max 5)",IDC_STATIC,236,248,80,10

    LTEXT           "Note: Retries use exponential backoff (1s, 2s, 4s...) for transient failures.",IDC_STATIC,20,268,290,10
END

IDD_PREFERENCES_ACRCLOUD DIALOGEX 0, 0, 350, 270
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         "Enable ACRCloud Live Stream Recognition",IDC_ENABLE_ACRCLOUD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,8,250,12

    GROUPBOX        "Primary Account",IDC_STATIC,10,24,320,85

    LTEXT           "Host:",IDC_STATIC,20,39,75,10
    EDITTEXT        IDC_ACRCLOUD_HOST,98,37,205,14,ES_AUTOHSCROLL

    LTEXT           "Access Key:",IDC_STATIC,20,59,75,10
    EDITTEXT        IDC_ACRCLOUD_ACCESS_KEY,98,57,205,14,ES_AUTOHSCROLL

    LTEXT           "Access Secret:",IDC_STATIC,20,79,75,10
    EDITTEXT        IDC_ACRCLOUD_ACCESS_SECRET,98,77,205,14,ES_AUTOHSCROLL | ES_PASSWORD

    GROUPBOX        "Secondary Account (Failover on Error 3001)",IDC_STATIC,10,116,320,85

    LTEXT           "Host:",IDC_STATIC,20,131,75,10
    EDITTEXT        IDC_ACRCLOUD_HOST2,98,129,205,14,ES_AUTOHSCROLL

    LTEXT           "Access Key:",IDC_STATIC,20,151,75,10
    EDITTEXT        IDC_ACRCLOUD_ACCESS_KEY2,98,149,205,14,ES_AUTOHSCROLL

    LTEXT           "Access Secret:",IDC_STATIC,20,171,75,10
    EDITTEXT        IDC_ACRCLOUD_ACCESS_SECRET2,98,169,205,14,ES_AUTOHSCROLL | ES_PASSWORD

    LTEXT           "Note: Automatic failover switches to Secondary when Primary request limit is reached.",IDC_STATIC,15,210,310,10
    LTEXT           "Create free developer accounts at: https://console.acrcloud.com/",IDC_STATIC,15,224,310,10
END


